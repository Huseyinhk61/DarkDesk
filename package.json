{
  "name": "darkdesk",
  "version": "3.11.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "test": "node --test electron/*.test.cjs",
    "desktop:preview": "npm run build && electron . --production",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "check": "npm test && npm run build && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "format": "prettier --write src shared electron tests scripts *.json *.js *.md docs/*.md .github",
    "postinstall": "node node_modules/electron/install.js",
    "icons": "node scripts/generate-folder-icons.mjs && node scripts/generate-colored-folder-icons.mjs",
    "verify:win": "node scripts/verify-windows-release.cjs",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/ci-test-reporter.cjs --test-reporter-destination=stdout electron/*.test.cjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.50.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "re2js": "^2.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2",
    "yaml": "^2.9.1"
  },
  "description": "A local-first desktop organizer with smart groups, workspace profiles and reversible file operations",
  "author": "Huseyinhk61",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "io.darkdesk.app",
    "productName": "DarkDesk",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "!electron/**/*.test.cjs",
      "package.json",
      "build/icon.png",
      "shared/**/*",
      "build/folder-icons/**/*.ico",
      "src/locales/*.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DarkDesk",
      "artifactName": "DarkDesk-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DarkDesk-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "DarkDesk-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Huseyinhk61",
        "repo": "DarkDesk",
        "releaseType": "release",
        "private": false
      }
    ],
    "generateUpdatesFilesForAllChannels": true,
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libglib2.0-bin"
      ],
      "maintainer": "DarkDesk contributors"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Huseyinhk61/DarkDesk.git"
  },
  "homepage": "https://github.com/Huseyinhk61/DarkDesk#readme",
  "bugs": {
    "url": "https://github.com/Huseyinhk61/DarkDesk/issues"
  },
  "keywords": [
    "desktop-organizer",
    "electron",
    "react",
    "windows",
    "productivity",
    "local-first"
  ],
  "optionalDependencies": {
    "koffi": "^3.3.7"
  },
  "desktopName": "darkdesk.desktop"
}
